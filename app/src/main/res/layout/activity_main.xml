<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#DDDDDD"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/panelCalculadora"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnHistorial"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/historial"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="@string/icono_historial"
                android:textColor="#000000"
                android:textSize="22sp"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="0dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/titulo"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnAjustes"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/ajustes"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="@string/icono_ajustes"
                android:textColor="#000000"
                android:textSize="22sp"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="0dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="6dp"
            android:layout_weight="1"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:text="@string/grados"
                android:textColor="#000000"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/txtExpresion"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:gravity="bottom|end"
                android:textColor="#000000"
                android:textSize="34sp" />
        </LinearLayout>

        <GridLayout
            android:id="@+id/teclado"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3.3"
            android:columnCount="4"
            android:rowCount="7">

            <Button
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="@string/btn_sen"
                android:textColor="#000000"
                android:textSize="16sp"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="0dp" />

            <Button
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="@string/btn_cos"
                android:textColor="#000000"
                android:textSize="16sp"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="0dp" />

            <Button
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="@string/btn_tan"
                android:textColor="#000000"
                android:textSize="16sp"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="0dp" />

            <Button
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="@string/btn_borrar"
                android:textColor="#000000"
                android:textSize="20sp"
                app:backgroundTint="#F08080"
                app:cornerRadius="0dp" />

            <Button
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnSpan="2"
                android:layout_columnWeight="2"
                android:layout_gravity="fill"
                android:layout_margin="3dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="@string/btn_raiz"
                android:textColor="#000000"
                android:textSize="24sp"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="0dp" />

            <Button
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnSpan="2"
                android:layout_columnWeight="2"
                android:layout_gravity="fill"
                android:layout_margin="3dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="@string/btn_potencia"
                android:textColor="#000000"
                android:textSize="24sp"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="0dp" />

            <Button
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="@string/btn_abrir"
                android:textColor="#000000"
                android:textSize="24sp"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="0dp" />

            <Button
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="@string/btn_cerrar"
                android:textColor="#000000"
                android:textSize="24sp"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="0dp" />

            <Button
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="@string/btn_retroceso"
                android:textColor="#000000"
                android:textSize="22sp"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="0dp" />

            <Button
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="@string/btn_dividir"
                android:textColor="#000000"
                android:textSize="24sp"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="0dp" />

            <Button
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="@string/btn_7"
                android:textColor="#000000"
                android:textSize="24sp"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="0dp" />

            <Button
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="@string/btn_8"
                android:textColor="#000000"
                android:textSize="24sp"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="0dp" />

            <Button
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="@string/btn_9"
                android:textColor="#000000"
                android:textSize="24sp"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="0dp" />

            <Button
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="@string/btn_multiplicar"
                android:textColor="#000000"
                android:textSize="24sp"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="0dp" />

            <Button
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="@string/btn_4"
                android:textColor="#000000"
                android:textSize="24sp"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="0dp" />

            <Button
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="@string/btn_5"
                android:textColor="#000000"
                android:textSize="24sp"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="0dp" />

            <Button
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="@string/btn_6"
                android:textColor="#000000"
                android:textSize="24sp"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="0dp" />

            <Button
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="@string/btn_restar"
                android:textColor="#000000"
                android:textSize="24sp"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="0dp" />

            <Button
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="@string/btn_1"
                android:textColor="#000000"
                android:textSize="24sp"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="0dp" />

            <Button
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="@string/btn_2"
                android:textColor="#000000"
                android:textSize="24sp"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="0dp" />

            <Button
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="@string/btn_3"
                android:textColor="#000000"
                android:textSize="24sp"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="0dp" />

            <Button
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="@string/btn_sumar"
                android:textColor="#000000"
                android:textSize="24sp"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="0dp" />

            <Button
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="@string/btn_0"
                android:textColor="#000000"
                android:textSize="24sp"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="0dp" />

            <Button
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="@string/btn_punto"
                android:textColor="#000000"
                android:textSize="24sp"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="0dp" />

            <Button
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnSpan="2"
                android:layout_columnWeight="2"
                android:layout_gravity="fill"
                android:layout_margin="3dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="@string/btn_igual"
                android:textColor="#000000"
                android:textSize="26sp"
                app:backgroundTint="#90EE90"
                app:cornerRadius="0dp" />
        </GridLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/panelHistorial"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnVolver"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/volver"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="@string/icono_volver"
                android:textColor="#000000"
                android:textSize="22sp"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="0dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/historial"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtContador"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#000000"
                android:textSize="13sp" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#FFFFFF">

            <TextView
                android:id="@+id/txtHistorial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:gravity="end"
                android:lineSpacingExtra="4dp"
                android:padding="16dp"
                android:textColor="#000000"
                android:textSize="20sp" />
        </ScrollView>
    </LinearLayout>

</FrameLayout>
